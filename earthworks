#!/usr/bin/env bash

set -u

usage() {
    cat <<'EOF'
Usage:
  ./earthworks <machine> <environment>

Machines:
  cat-302-cr  CAT 302 CR
  blast-dog   IMDEX Blast Dog

Environments:
  goose       AARP Goose
  empty       Empty Worksite
  forest      Forest Worksite, based on Goose data

Examples:
  ./earthworks cat-302-cr goose
  ./earthworks blast-dog goose
EOF
}

if (( $# == 1 )) && [[ $1 == '-h' || $1 == '--help' ]]; then
    usage
    exit 0
fi

if (( $# != 2 )); then
    printf 'A machine and environment are required.\n\n' >&2
    usage >&2
    exit 1
fi

project_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ros_setup=/opt/ros/jazzy/setup.bash
workspace_setup="$project_dir/excavator/install/setup.bash"

case $1 in
    cat-302-cr)
        machine='Standard CAT 302 CR'
        robot_package=excavator
        ;;
    blast-dog)
        machine='IMDEX BLASTDOG'
        robot_package=excavator
        ;;
    *)
        printf 'Unknown machine: %s\n' "$1" >&2
        printf 'Choose cat-302-cr or blast-dog.\n' >&2
        exit 1
        ;;
esac

case $2 in
    goose)
        environment='AARP Goose'
        world_file="$project_dir/excavator/worlds/aarp_goose_demo_v2.sdf"
        ;;
    empty)
        environment='Empty Worksite'
        world_file="$project_dir/excavator/worlds/excavator_empty.sdf"
        ;;
    forest)
        environment='Forest Worksite'
        world_file="$project_dir/worlds/goose_forest.sdf"
        ;;
    *)
        printf 'Unknown environment: %s\n' "$2" >&2
        printf 'Choose goose, empty, or forest.\n' >&2
        exit 1
        ;;
esac

if [[ ! -f $ros_setup ]]; then
    printf 'ROS 2 Jazzy was not found at %s.\n' "$ros_setup" >&2
    exit 1
fi

if [[ ! -f $workspace_setup ]]; then
    printf 'The excavator workspace has not been built.\n' >&2
    printf 'Build it first with: cd "%s/excavator" && colcon build --symlink-install\n' "$project_dir" >&2
    exit 1
fi

printf '\nMachine selected: %s\n' "$machine"
printf 'Environment selected: %s\n' "$environment"
if [[ $1 == 'blast-dog' ]]; then
    printf 'Using the shared CAT 302 CR simulation model for BLASTDOG.\n'
fi
printf 'Starting the simulator...\n\n'

# ROS setup scripts may reference variables that have not been defined yet.
set +u
# shellcheck source=/opt/ros/jazzy/setup.bash
source "$ros_setup"
# shellcheck source=/dev/null
source "$workspace_setup"
set -u

gnome-terminal -- bash -c "cd excavator/ && source install/setup.bash && source /opt/ros/jazzy/setup.bash && ros2 run excavator excavator_teleop"

export GZ_SIM_RESOURCE_PATH="${GZ_SIM_RESOURCE_PATH:+$GZ_SIM_RESOURCE_PATH:}$project_dir"
exec ros2 launch "$robot_package" robot.launch.py \
    "world:=$world_file" \
    "machine_variant:=$1"
