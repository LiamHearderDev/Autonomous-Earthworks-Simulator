{
  "name": "Autonomous Earthworks Simulator",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-python.python",
        "redhat.vscode-yaml",
        "xaver.clang-format",
        "redhat.vscode-xml"
      ],
      "settings": {
        "cmake.configureOnOpen": true,
        "cmake.generator": "Ninja",
        "C_Cpp.default.cppStandard": "c++17",
        "editor.formatOnSave": true
      }
    }
  },
  "remoteUser": "root",
  "containerEnv": {
    "GZ_VERSION": "harmonic",
    "ROS_DISTRO": "jazzy"
  }
}
