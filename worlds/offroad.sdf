<?xml version="1.0" ?>
<sdf version="1.10">

  <world name="offroad">

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.72 0.84 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 30 0 0 0</pose>

      <diffuse>0.95 0.92 0.84 1</diffuse>
      <specular>0 0 0 1</specular>

      <direction>-0.4 0.3 -1</direction>
    </light>

    <gui fullscreen="0">

      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>

        <engine>ogre2</engine>
        <scene>scene</scene>

        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>

        <camera_pose>-35 0 12 0 0.20 0</camera_pose>

        <camera_clip>
          <near>0.25</near>
          <far>25000</far>
        </camera_clip>
      </plugin>

      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

    </gui>

    <model name="offroad_terrain">

      <static>true</static>

      <link name="terrain_link">

        <collision name="terrain_collision">

          <geometry>

            <heightmap>

              <uri>
                heightmaps/offroad_heightmap.png
              </uri>

              <size>100 100 10</size>

              <pos>0 0 -3.4</pos>

              <sampling>2</sampling>

            </heightmap>

          </geometry>

        </collision>


        <visual name="terrain_visual">

          <geometry>

            <heightmap>

              <uri>
                heightmaps/offroad_heightmap.png
              </uri>

              <size>100 100 10</size>

              <pos>0 0 -3.4</pos>

              <sampling>2</sampling>

              <texture>

                <diffuse>
                  heightmaps/offroad_diffuse.png
                </diffuse>

                <normal>
                  heightmaps/offroad_normal.png
                </normal>

                <size>10</size>

              </texture>

            </heightmap>

          </geometry>

        </visual>

      </link>

    </model>

    <model name="rock_1">
      <static>true</static>
      <pose>-14 28 0.5 0.15 0.20 0.3</pose>
      <link name="rock">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.7 1.3 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.7 1.3 1.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.30 0.28 0.24 1</ambient>
            <diffuse>0.40 0.37 0.31 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rock_2">
      <static>true</static>
      <pose>-30  12 0.5 0.10 0.18 1.0</pose>
      <link name="rock">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.7 1.3 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.1 0.8 0.7</size>
            </box>
          </geometry>

          <material>
            <ambient>0.30 0.28 0.24 1</ambient>
            <diffuse>0.40 0.37 0.31 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rock_3">
      <static>true</static>
      <pose>-22 -18 0.5 0.20 0.10 2.0</pose>
      <link name="rock">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.5 1.9 1.6</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.7 1.3 1.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.30 0.28 0.24 1</ambient>
            <diffuse>0.40 0.37 0.31 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rock_4">
      <static>true</static>
      <pose> 18  27 0.5 0.12 0.22 0.5</pose>
      <link name="rock">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 1.1 1.4</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.7 1.3 1.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.30 0.28 0.24 1</ambient>
            <diffuse>0.40 0.37 0.31 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rock_5">
      <static>true</static>
      <pose> 31  13 0.5 0.18 0.12 1.8</pose>
      <link name="rock">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.9 1.1 0.9</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.7 1.3 1.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.30 0.28 0.24 1</ambient>
            <diffuse>0.40 0.37 0.31 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>

</sdf>