<?xml version="1.0"?>
<robot name="excavator">

  <material name="blue">
    <color rgba="0.0 0.0 1.0 1"/>
  </material>
  <material name="red">
    <color rgba="1.0 0.0 0.0 1"/>
  </material>
  <material name="green">
    <color rgba="0.0 1.0 0.0 1"/>
  </material>

  <!-- ================= CHASSIS ================= -->
  <link name="chassis">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="100"/>
      <inertia ixx="0.095329" ixy="0" ixz="0"
               iyy="0.381317" iyz="0"
               izz="0.476646"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="2.0 1.0 0.5"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="2.0 1.0 0.5"/>
      </geometry>
    </collision>
  </link>

  <!-- ================= UPPER ARM ================= -->
  <link name="upper_arm">
    <inertial>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.43333" ixy="0" ixz="0"
               iyy="0.43333" iyz="0"
               izz="0.8"/>
    </inertial>
    <visual>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.3" length="2.0"/>
      </geometry>
      <material name="green"/>
    </visual>
    <!-- <collision>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.2" length="2.0"/>
      </geometry>
    </collision> -->
  </link>

  <joint name="upper_arm_joint" type="revolute">
    <parent link="chassis"/>
    <child link="upper_arm"/>
    <origin xyz="1.0 0 0.25" rpy="0 0.785398 0"/> <!-- Front + angled 45 degrees. -->
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="1.0" effort="1000" velocity="0.5" />
    <dynamics damping="0.2" friction="0.0"/>
  </joint>

  <!-- ================= BACK LEFT WHEEL ================= -->
  <link name="back_left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.043333" ixy="0" ixz="0"
               iyy="0.043333" iyz="0"
               izz="0.08"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
    </collision>
  </link>

  <joint name="back_left_wheel_joint" type="continuous">
    <origin xyz="-0.5 0.6 0" rpy="-1.5707 0 0"/>
    <parent link="chassis"/>
    <child link="back_left_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <gazebo reference="back_left_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.02</mu>
            <mu2>1.0</mu2>
            <fdir1>0 0 1</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <!-- ================= BACK RIGHT WHEEL ================= -->
  <link name="back_right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.043333" ixy="0" ixz="0"
               iyy="0.043333" iyz="0"
               izz="0.08"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
    </collision>
  </link>

  <joint name="back_right_wheel_joint" type="continuous">
    <origin xyz="-0.5 -0.6 0" rpy="-1.5707 0 0"/>
    <parent link="chassis"/>
    <child link="back_right_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <gazebo reference="back_right_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.02</mu>
            <mu2>1.0</mu2>
            <fdir1>0 0 1</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <!-- ================= FRONT LEFT WHEEL ================= -->
  <link name="front_left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.043333" ixy="0" ixz="0"
               iyy="0.043333" iyz="0"
               izz="0.08"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <origin xyz="0.5 0.6 0" rpy="-1.5707 0 0"/>
    <parent link="chassis"/>
    <child link="front_left_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <gazebo reference="front_left_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.02</mu>  <!-- low grip sideways, allows scrub -->
            <mu2>1.0</mu2> <!-- high grip in rolling direction -->
            <fdir1>0 0 1</fdir1>  <!-- rolling axis direction, in link's local frame -->
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <!-- ================= FRONT RIGHT WHEEL ================= -->
  <link name="front_right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.043333" ixy="0" ixz="0"
               iyy="0.043333" iyz="0"
               izz="0.08"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <origin xyz="0.5 -0.6 0" rpy="-1.5707 0 0"/>
    <parent link="chassis"/>
    <child link="front_right_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <gazebo reference="front_right_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.02</mu>
            <mu2>1.0</mu2>
            <fdir1>0 0 1</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <!-- ================= DIFF DRIVE PLUGIN ================= -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>back_left_wheel_joint</left_joint>
      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>back_right_wheel_joint</right_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <wheel_separation>1.2</wheel_separation>
      <wheel_radius>0.4</wheel_radius>
      <odom_publish_frequency>1</odom_publish_frequency>
      <topic>cmd_vel</topic>
    </plugin>
  </gazebo>

  <!-- ================= JOINT CONTROLLER PLUGIN ================= -->
  <gazebo>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>upper_arm_joint</joint_name>
      <topic>/model/excavator/joint/upper_arm_joint/cmd_vel</topic>
      <use_force_commands>true</use_force_commands>
      <p_gain>3000.0</p_gain>   <!-- Used to correct differences in expected force and actual force. Higher = more correction. -->
      <i_gain>10.0</i_gain>     <!-- Used to correct small persistent errors that P alone doesn't fix. -->
      <d_gain>0.5</d_gain>
    </plugin>
  </gazebo>
</robot>