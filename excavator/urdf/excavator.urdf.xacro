<?xml version="1.0"?>
<robot
  name="excavator"
  xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find excavator)/model/control.xacro"/>
  <xacro:include filename="$(find excavator)/model/blastdog_attachment.xacro"/>

  <xacro:arg name="machine_variant" default="cat-302-cr"/>
  <xacro:property name="machine_variant" value="$(arg machine_variant)"/>

  <material name="blue">
    <color rgba="0.0 0.0 1.0 1"/>
  </material>
  <material name="red">
    <color rgba="1.0 0.0 0.0 1"/>
  </material>
  <material name="green">
    <color rgba="0.0 1.0 0.0 1"/>
  </material>

  <!-- ================= ROOT ================= -->
  <link name="root">
  </link>

  <!-- ================= BASE ================= -->
  <link name="base">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="100"/>
      <inertia ixx="10.4167" ixy="0" ixz="0"
               iyy="35.4167" iyz="0"
               izz="41.6667"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="2.0 1.0 0.5"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="2.0 1.0 0.5"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 1.5708"/>
    <parent link="root"/>
    <child link="base"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- ================= CHASSIS ================= -->
  <link name="chassis">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="50"/>
      <inertia ixx="8.3333" ixy="0" ixz="0"
           iyy="13.5417" iyz="0"
           izz="13.5417"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.5 1.0 1.0"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <!-- <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.5 1.0 1.0"/>
      </geometry>
    </collision> -->
  </link>

  <joint name="chassis_joint" type="revolute">
    <parent link="base"/>
    <child link="chassis"/>
    <origin xyz="0 0 1.25" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="1000" velocity="0.5" />
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- ================= UPPER ARM ================= -->
  <link name="upper_arm">
    <inertial>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <mass value="20.0"/>
      <inertia ixx="7.1167" ixy="0" ixz="0"
           iyy="7.1167" iyz="0"
           izz="0.9000"/>
    </inertial>
    <visual>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.2" length="2.0"/>
      </geometry>
      <material name="green"/>
    </visual>
    <!-- <collision>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.2" length="2.0"/>
      </geometry>
    </collision> -->
  </link>

  <joint name="upper_arm_joint" type="revolute">
    <parent link="chassis"/>
    <child link="upper_arm"/>
    <origin xyz="1.0 0 0.25" rpy="0 0.785398 0"/> <!-- Front + angled 45 degrees. -->
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="1000" velocity="0.5" />
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <!-- ================= LOWER ARM ================= -->
  <link name="lower_arm">
    <inertial>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="7.1167" ixy="0" ixz="0"
           iyy="7.1167" iyz="0"
           izz="0.9000"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.2" length="1.0"/>
      </geometry>
      <material name="green"/>
    </visual>
  </link>

  <joint name="lower_arm_joint" type="revolute">
    <parent link="upper_arm"/>
    <child link="lower_arm"/>
    <origin xyz="0 0 2.0" rpy="0 2.356194 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="1.0" effort="1000" velocity="0.5" />
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <!-- BLASTDOG reuses the excavator and replaces its tool with a sensing probe. -->
  <xacro:if value="${machine_variant == 'blast-dog'}">
    <xacro:blastdog_attachment parent="lower_arm"/>
  </xacro:if>

  <!-- ================= BACK LEFT WHEEL ================= -->
  <link name="back_left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.2167" ixy="0" ixz="0"
           iyy="0.2167" iyz="0"
           izz="0.4000"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
    </collision>
  </link>

  <joint name="back_left_wheel_joint" type="continuous">
    <origin xyz="-0.5 0.6 0" rpy="-1.5707 0 0"/>
    <parent link="base"/>
    <child link="back_left_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <gazebo reference="back_left_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.02</mu>
            <mu2>1.0</mu2>
            <fdir1>0 0 1</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <!-- ================= BACK RIGHT WHEEL ================= -->
  <link name="back_right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.2167" ixy="0" ixz="0"
           iyy="0.2167" iyz="0"
           izz="0.4000"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
    </collision>
  </link>

  <joint name="back_right_wheel_joint" type="continuous">
    <origin xyz="-0.5 -0.6 0" rpy="-1.5707 0 0"/>
    <parent link="base"/>
    <child link="back_right_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <gazebo reference="back_right_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.02</mu>
            <mu2>1.0</mu2>
            <fdir1>0 0 1</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <!-- ================= FRONT LEFT WHEEL ================= -->
  <link name="front_left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.2167" ixy="0" ixz="0"
           iyy="0.2167" iyz="0"
           izz="0.4000"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <origin xyz="0.5 0.6 0" rpy="-1.5707 0 0"/>
    <parent link="base"/>
    <child link="front_left_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <gazebo reference="front_left_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.02</mu>  <!-- low grip sideways, allows scrub -->
            <mu2>1.0</mu2> <!-- high grip in rolling direction -->
            <fdir1>0 0 1</fdir1>  <!-- rolling axis direction, in link's local frame -->
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <!-- ================= FRONT RIGHT WHEEL ================= -->
  <link name="front_right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.2167" ixy="0" ixz="0"
           iyy="0.2167" iyz="0"
           izz="0.4000"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <origin xyz="0.5 -0.6 0" rpy="-1.5707 0 0"/>
    <parent link="base"/>
    <child link="front_right_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <gazebo reference="front_right_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.02</mu>
            <mu2>1.0</mu2>
            <fdir1>0 0 1</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <!-- ================= DIFF DRIVE PLUGIN ================= -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>back_left_wheel_joint</left_joint>
      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>back_right_wheel_joint</right_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <wheel_separation>1.2</wheel_separation>
      <wheel_radius>0.4</wheel_radius>
      <odom_publish_frequency>1</odom_publish_frequency>
      <topic>cmd_vel</topic>
    </plugin>
  </gazebo>

  <!-- ================= JOINT CONTROLLER PLUGIN ================= -->
  <!-- deleted for now -->

  <!-- ================= JOINT PUBLISHER ================= -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
    </plugin>
  </gazebo>
</robot>
