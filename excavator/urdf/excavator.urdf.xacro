<?xml version="1.0"?>
<robot
  name="excavator"
  xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="machine_variant" default="cat-302-cr"/>
  <xacro:property name="machine_variant" value="$(arg machine_variant)"/>

  <xacro:include filename="$(find excavator)/model/control.xacro"/>
  <xacro:include filename="$(find excavator)/model/blastdog_attachment.xacro"/>

  <material name="blue">  <color rgba="0.0 0.0 1.0 1"/>   </material>
  <material name="red">   <color rgba="1.0 0.0 0.0 1"/>   </material>
  <material name="green"> <color rgba="0.0 1.0 0.0 1"/>   </material>

  <!-- ================= ROOT ================= -->
  <link name="root">
  </link>



  <!-- ================= BASE ================= -->
  <link name="base">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="100"/>
      <inertia ixx="10.4167" ixy="0" ixz="0"
               iyy="35.4167" iyz="0"
               izz="41.6667"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://excavator/meshes/CAT302_Base.obj"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://excavator/meshes/CAT302_Base_Collision.obj"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 1.57"/>
    <parent link="root"/>
    <child link="base"/>
    <axis xyz="0 0 1"/>
  </joint>



  <!-- ================= CHASSIS ================= -->
  <link name="chassis">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="50"/>
      <inertia ixx="8.3333" ixy="0" ixz="0"
           iyy="13.5417" iyz="0"
           izz="13.5417"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://excavator/meshes/CAT302_Chassis.obj"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://excavator/meshes/CAT302_Chassis_Collision.obj"/>
      </geometry>
    </collision>
  </link>

  <joint name="chassis_joint" type="revolute">
    <parent link="base"/>
    <child link="chassis"/>
    <origin xyz="0.24113 0.003227 1.2527" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="1000" velocity="0.5" />
    <dynamics damping="0.1" friction="0.0"/>
  </joint>



  <!-- ================= UPPER ARM ================= -->
  <link name="upper_arm">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="20.0"/>
      <inertia ixx="7.1167" ixy="0" ixz="0"
           iyy="7.1167" iyz="0"
           izz="0.9000"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://excavator/meshes/CAT302_Boom.obj"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 1" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://excavator/meshes/CAT302_Boom_Collision.obj"/>
      </geometry>
    </collision>
  </link>

  <joint name="upper_arm_joint" type="revolute">
    <parent link="chassis"/>
    <child link="upper_arm"/>
    <origin xyz="2.58711 0.145316 -0.47084" rpy="0 0 0"/> <!-- Front + angled 45 degrees. -->
    <axis xyz="0 1 0"/>
    <limit lower="-3.0" upper="3.0" effort="1000" velocity="0.5" />
    <dynamics damping="0.5" friction="0.0"/>
  </joint>



  <!-- ================= LOWER ARM ================= -->
  <link name="lower_arm">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="7.1167" ixy="0" ixz="0"
           iyy="7.1167" iyz="0"
           izz="0.9000"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://excavator/meshes/CAT302_Stick.obj"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://excavator/meshes/CAT302_Stick_Collision.obj"/>
      </geometry>
    </collision>
  </link>

  <joint name="lower_arm_joint" type="revolute">
    <parent link="upper_arm"/>
    <child link="lower_arm"/>
    <origin xyz="4.40739 0 2.31958" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.0" upper="3.0" effort="1000" velocity="0.5" />
    <dynamics damping="0.5" friction="0.0"/>
  </joint>
  


  <!-- ================= BUCKET ================= -->
  <link name="bucket">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="7.1167" ixy="0" ixz="0"
           iyy="7.1167" iyz="0"
           izz="0.9000"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://excavator/meshes/CAT302_Bucket.obj"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://excavator/meshes/CAT302_Bucket.obj"/>
      </geometry>
    </collision>
  </link>

  <joint name="bucket_joint" type="revolute">
    <origin xyz="0.003227 0.00035 -3.11855"/>
    <parent link="lower_arm"/>
    <child link="bucket"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.0" upper="3.0" effort="1000" velocity="0.5" />
    <dynamics damping="0.5" friction="0.0"/>
  </joint>



  <!-- ================= TREADS (only visual) ================= -->
  <link name="left_treads">
    <visual>
      <geometry>
        <mesh filename="package://excavator/meshes/CAT302_Treads.obj"/>
      </geometry>
    </visual>
  </link>

  <joint name="left_treads_joint" type="fixed">
    <origin xyz="0 1.53764 -0.467052" rpy="0 0 -1.5707"/>
    <parent link="base"/>
    <child link="left_treads"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="right_treads">
    <visual>
      <geometry>
        <mesh filename="package://excavator/meshes/CAT302_Treads.obj"/>
      </geometry>
    </visual>
  </link>

  <joint name="right_treads_joint" type="fixed">
    <origin xyz="0 -1.53764 -0.467052" rpy="0 0 -1.5707"/>
    <parent link="base"/>
    <child link="right_treads"/>
    <axis xyz="0 0 1"/>
  </joint>



  <!-- ================= MIDDLE LEFT WHEEL  ================= -->
  <link name="middle_left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.2167" ixy="0" ixz="0"
           iyy="0.2167" iyz="0"
           izz="0.4000"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.493" length="0.3"/>
      </geometry>
    </collision>
  </link>

  <joint name="middle_left_wheel_joint" type="continuous">
    <origin xyz="0 1.53764 -0.467052" rpy="-1.5707 0 0"/>
    <parent link="base"/>
    <child link="middle_left_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <gazebo reference="middle_left_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.02</mu2>
            <fdir1>0 0 1</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>



  <!-- ================= MIDDLE RIGHT WHEEL  ================= -->
  <link name="middle_right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.2167" ixy="0" ixz="0"
           iyy="0.2167" iyz="0"
           izz="0.4000"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.493" length="0.3"/>
      </geometry>
    </collision>
  </link>

  <joint name="middle_right_wheel_joint" type="continuous">
    <origin xyz="0 -1.53764 -0.467052" rpy="-1.5707 0 0"/>
    <parent link="base"/>
    <child link="middle_right_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <gazebo reference="middle_right_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.02</mu2>
            <fdir1>0 0 1</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>


  <!-- BLASTDOG reuses the excavator and replaces its tool with a sensing probe. -->
  <xacro:if value="${machine_variant == 'blast-dog'}">
    <xacro:blastdog_attachment parent="lower_arm"/>
  </xacro:if>
  
  <!-- ================= CAMERA 1 ================= -->
  <link name="camera1_link">
    <inertial>
      <mass value="0"/>
      <inertia ixx="0.000" ixy="0.0" ixz="0.0" iyy="0.000" iyz="0.0" izz="0.000"/>
    </inertial>
  </link>

  <gazebo reference="camera1_link">
    <sensor name="excavator_camera1" type="rgbd_camera">
      <camera name="camera1">
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>960</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>

      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>1</visualize>
      <topic>/cam1/rgbd_camera</topic>
    </sensor>
  </gazebo>

  <joint name="camera1_joint" type="fixed">
    <parent link="chassis"/>
    <child link="camera1_link"/>
    <origin xyz="0 0 1" rpy="0 0.26179 0"/>
    <axis xyz="0 1 0"/>
  </joint>

   <!-- ================= CAMERA 2 ================= -->
  <link name="camera2_link">
    <inertial>
      <mass value="0"/>
      <inertia ixx="0.000" ixy="0.0" ixz="0.0" iyy="0.000" iyz="0.0" izz="0.000"/>
    </inertial>
  </link>

  <gazebo reference="camera2_link">
    <sensor name="excavator_camera2" type="rgbd_camera">
      <camera name="camera2">
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>960</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>

      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>1</visualize>
      <topic>/cam2/rgbd_camera</topic>
    </sensor>
  </gazebo>

  <joint name="camera2_joint" type="fixed">
    <parent link="chassis"/>
    <child link="camera2_link"/>
    <origin xyz="1.3 1.25 3.7" rpy="0 0.6283 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ================= BACK LEFT WHEEL ================= -->
  <link name="back_left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.2167" ixy="0" ixz="0"
           iyy="0.2167" iyz="0"
           izz="0.4000"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.493" length="0.3"/>
      </geometry>
    </collision>

    <!-- <visual>
      <geometry>
        <cylinder radius="0.493" length="0.3"/>
      </geometry>
    </visual> -->

  </link>

  <joint name="back_left_wheel_joint" type="continuous">
    <origin xyz="-2.4672 1.53764 -0.467052" rpy="-1.5707 0 0"/>
    <parent link="base"/>
    <child link="back_left_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <gazebo reference="back_left_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.02</mu>
            <mu2>1.0</mu2>
            <fdir1>0 0 1</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>



  <!-- ================= BACK RIGHT WHEEL ================= -->
  <link name="back_right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.2167" ixy="0" ixz="0"
           iyy="0.2167" iyz="0"
           izz="0.4000"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.493" length="0.3"/>
      </geometry>
    </collision>

    <!-- <visual>
      <geometry>
        <cylinder radius="0.493" length="0.3"/>
      </geometry>
    </visual> -->

  </link>

  <joint name="back_right_wheel_joint" type="continuous">
    <origin xyz="-2.4672 -1.53764 -0.467052" rpy="-1.5707 0 0"/>
    <parent link="base"/>
    <child link="back_right_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <gazebo reference="back_right_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.02</mu>
            <mu2>1.0</mu2>
            <fdir1>0 0 1</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>



  <!-- ================= FRONT LEFT WHEEL ================= -->
  <link name="front_left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.2167" ixy="0" ixz="0"
           iyy="0.2167" iyz="0"
           izz="0.4000"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.493" length="0.3"/>
      </geometry>
    </collision>

    <!-- <visual>
      <geometry>
        <cylinder radius="0.493" length="0.3"/>
      </geometry>
    </visual> -->

  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <origin xyz="2.4672 1.53764 -0.467052" rpy="-1.5707 0 0"/>
    <parent link="base"/>
    <child link="front_left_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <gazebo reference="front_left_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.02</mu>  <!-- low grip sideways, allows scrub -->
            <mu2>1.0</mu2> <!-- high grip in rolling direction -->
            <fdir1>0 0 1</fdir1>  <!-- rolling axis direction, in link's local frame -->
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>



  <!-- ================= FRONT RIGHT WHEEL ================= -->
  <link name="front_right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.2167" ixy="0" ixz="0"
           iyy="0.2167" iyz="0"
           izz="0.4000"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.493" length="0.3"/>
      </geometry>
    </collision>

    <!-- <visual>
      <geometry>
        <cylinder radius="0.493" length="0.3"/>
      </geometry>
    </visual> -->

  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <origin xyz="2.4672 -1.53764 -0.467052" rpy="-1.5707 0 0"/>
    <parent link="base"/>
    <child link="front_right_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <gazebo reference="front_right_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.02</mu>
            <mu2>1.0</mu2>
            <fdir1>0 0 1</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <!-- ================= CAMERA PLUGIN ================= -->

  <gazebo>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
      <topic>rgbd_camera</topic>
    </plugin>
  </gazebo>

  <!-- ================= DIFF DRIVE PLUGIN ================= -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>back_left_wheel_joint</left_joint>
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>middle_left_wheel_joint</left_joint>
      <right_joint>back_right_wheel_joint</right_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>middle_right_wheel_joint</right_joint>
      <wheel_separation>3.07528</wheel_separation>
      <wheel_radius>0.493</wheel_radius>
      <odom_publish_frequency>1</odom_publish_frequency>
      <topic>cmd_vel</topic>
    </plugin>
  </gazebo>



  <!-- ================= JOINT PUBLISHER ================= -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
    </plugin>
  </gazebo>
</robot>
