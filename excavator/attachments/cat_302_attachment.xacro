<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    First-pass Cat-302 CR Mini attachment.

   

    The probe is deployed vertically by a one-metre prismatic joint.
  -->
  <xacro:macro name="cat_302_attachment" params="parent">
    <link name="bucket">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia ixx="7.1167" ixy="0" ixz="0"
            iyy="7.1167" iyz="0"
            izz="0.9000"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://excavator/meshes/CAT302_Bucket.obj"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://excavator/meshes/CAT302_Bucket.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="bucket_joint" type="revolute">
      <origin xyz="0.003227 0.00035 -3.11855"/>
      <parent link="lower_arm"/>
      <child link="bucket"/>
      <axis xyz="0 1 0"/>
      <limit lower="-3.0" upper="3.0" effort="1000" velocity="0.5" />
      <dynamics damping="0.5" friction="0.0"/>
    </joint>
  </xacro:macro>

</robot>
