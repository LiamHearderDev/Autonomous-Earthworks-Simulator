<?xml version="1.0"?>

<!-- ROBOT MODEL PARAMETERS -->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ros2_control parameters -->
    <xacro:property name="control_update_rate" value="100"/>

    <xacro:property name="arm_command_interface" value="velocity"/>
    <xacro:property name="chassis_command_interface" value="velocity"/>

    <xacro:property name="arm_velocity_limit" value="0.5"/>
    <xacro:property name="chassis_velocity_limit" value="0.5"/>

</robot>