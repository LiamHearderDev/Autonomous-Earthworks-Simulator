<?xml version="1.0"?>

<!-- ROBOT MODEL PARAMETERS -->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ros2_control parameters -->
    <xacro:property name="control_update_rate" value="100"/>

    <xacro:property name="blade_command_interface" value="velocity"/>

    <xacro:property name="blade_velocity_limit" value="0.1"/>

</robot>