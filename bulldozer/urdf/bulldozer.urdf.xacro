<?xml version="1.0"?>
<robot name="bulldozer">

  <material name="blue">
    <color rgba="0.0 0.0 1.0 1"/>
  </material>
  <material name="red">
    <color rgba="1.0 0.0 0.0 1"/>
  </material>

  <!-- Inertia-free ROS root frame, coincident with the chassis. -->
  <link name="base_link"/>

  <joint name="base_link_to_chassis" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
  </joint>

  <!-- ================= CHASSIS ================= -->
  <link name="chassis">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5"/>
      <inertia ixx="0.095329" ixy="0" ixz="0"
               iyy="0.381317" iyz="0"
               izz="0.476646"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="2.0 1.0 0.5"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="2.0 1.0 0.5"/>
      </geometry>
    </collision>
  </link>

  <!-- ================= BLADE ================= -->
  <!-- Placeholder blade: 0.1 m thick, 1.6 m wide, 0.5 m high. -->
  <link name="blade">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <!-- Test mass; inertia calculated for this 1 kg solid box. -->
      <mass value="1.0"/>
      <inertia ixx="0.234167" ixy="0" ixz="0"
               iyy="0.021667" iyz="0"
               izz="0.214167"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 1.6 0.5"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 1.6 0.5"/>
      </geometry>
    </collision>
  </link>

  <!-- Fixed mounting for the first test; raising/lowering comes later. -->
  <joint name="chassis_to_blade" type="fixed">
    <origin xyz="1.15 0 0" rpy="0 0 0"/>
    <parent link="chassis"/>
    <child link="blade"/>
  </joint>

  <!-- ================= BACK LEFT WHEEL ================= -->
  <link name="back_left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.043333" ixy="0" ixz="0"
               iyy="0.043333" iyz="0"
               izz="0.08"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
    </collision>
  </link>

  <joint name="back_left_wheel_joint" type="continuous">
    <origin xyz="-0.5 0.6 0" rpy="-1.5707 0 0"/>
    <parent link="chassis"/>
    <child link="back_left_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <gazebo reference="back_left_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.02</mu>
            <mu2>1.0</mu2>
            <fdir1>0 0 1</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <!-- ================= BACK RIGHT WHEEL ================= -->
  <link name="back_right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.043333" ixy="0" ixz="0"
               iyy="0.043333" iyz="0"
               izz="0.08"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
    </collision>
  </link>

  <joint name="back_right_wheel_joint" type="continuous">
    <origin xyz="-0.5 -0.6 0" rpy="-1.5707 0 0"/>
    <parent link="chassis"/>
    <child link="back_right_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <gazebo reference="back_right_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.02</mu>
            <mu2>1.0</mu2>
            <fdir1>0 0 1</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <!-- ================= FRONT LEFT WHEEL ================= -->
  <link name="front_left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.043333" ixy="0" ixz="0"
               iyy="0.043333" iyz="0"
               izz="0.08"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <origin xyz="0.5 0.6 0" rpy="-1.5707 0 0"/>
    <parent link="chassis"/>
    <child link="front_left_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <gazebo reference="front_left_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.02</mu>  <!-- low grip sideways, allows scrub -->
            <mu2>1.0</mu2> <!-- high grip in rolling direction -->
            <fdir1>0 0 1</fdir1>  <!-- rolling axis direction, in link's local frame -->
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <!-- ================= FRONT RIGHT WHEEL ================= -->
  <link name="front_right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.043333" ixy="0" ixz="0"
               iyy="0.043333" iyz="0"
               izz="0.08"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <origin xyz="0.5 -0.6 0" rpy="-1.5707 0 0"/>
    <parent link="chassis"/>
    <child link="front_right_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <gazebo reference="front_right_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.02</mu>
            <mu2>1.0</mu2>
            <fdir1>0 0 1</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <!-- ================= DIFF DRIVE PLUGIN ================= -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>back_left_wheel_joint</left_joint>
      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>back_right_wheel_joint</right_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <wheel_separation>1.2</wheel_separation>
      <wheel_radius>0.4</wheel_radius>
      <odom_publish_frequency>1</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>/model/bulldozer/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
  </gazebo>

  <!-- ================= JOINT STATE PUBLISHER ================= -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>
</robot>
