<?xml version="1.0"?>
<robot name="bulldozer">

  <material name="blue">
    <color rgba="0.0 0.0 1.0 1"/>
  </material>
  <material name="red">
    <color rgba="1.0 0.0 0.0 1"/>
  </material>
  <material name="yellow">
    <color rgba="1.0 1.0 0.0 1"/>
  </material>

  <!-- Inertia-free ROS root frame, coincident with the chassis. -->
  <link name="base_link"/>

  <joint name="base_link_to_chassis" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
  </joint>

  <!-- ================= CHASSIS ================= -->
  <link name="chassis">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="62.4"/>
      <inertia ixx="40.352" ixy="0" ixz="0"
               iyy="125.008" iyz="0"
               izz="154.96"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="4.8 2.6 1"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="4.8 2.6 1"/>
      </geometry>
    </collision>
  </link>

  <!-- ================= BLADE ================= -->
  <link name="blade">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <!-- Inertia for the 1 kg, 0.2 x 2.6 x 1.0 m blade box. -->
      <inertia ixx="0.646667" ixy="0" ixz="0"
               iyy="0.086667" iyz="0"
               izz="0.566667"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 2.6 1.0"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 2.6 1.0"/>
      </geometry>
    </collision>
  </link>

  <!-- Place the blade ahead of the chassis without overlapping it. -->
  <joint name="chassis_to_blade" type="prismatic">
    <origin xyz="2.5 0 0" rpy="0 0 0"/>
    <parent link="chassis"/>
    <child link="blade"/>
    <!-- Slide vertically; positive displacement raises the blade. -->
    <axis xyz="0 0 1"/>
    <!-- Travel in metres, force in newtons, speed in metres/second. -->
    <limit lower="-0.3" upper="0.3" effort="100" velocity="0.2"/>
    <dynamics damping="5.0" friction="0.0"/>
  </joint>

  <!-- ================= BACK LEFT WHEEL ================= -->
  <link name="back_left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="10.0"/>
      <inertia ixx="1.808333" ixy="0" ixz="0"
               iyy="1.808333" iyz="0"
               izz="3.2"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.8" length="0.5"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.8" length="0.5"/>
      </geometry>
    </collision>
  </link>

  <joint name="back_left_wheel_joint" type="continuous">
    <origin xyz="-2 1.65 0" rpy="-1.5707 0 0"/>
    <parent link="chassis"/>
    <child link="back_left_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <gazebo reference="back_left_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.02</mu>
            <mu2>1.0</mu2>
            <fdir1>0 0 1</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <!-- ================= BACK RIGHT WHEEL ================= -->
  <link name="back_right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="10.0"/>
      <inertia ixx="1.808333" ixy="0" ixz="0"
               iyy="1.808333" iyz="0"
               izz="3.2"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.8" length="0.5"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.8" length="0.5"/>
      </geometry>
    </collision>
  </link>

  <joint name="back_right_wheel_joint" type="continuous">
    <origin xyz="-2 -1.65 0" rpy="-1.5707 0 0"/>
    <parent link="chassis"/>
    <child link="back_right_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <gazebo reference="back_right_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.02</mu>
            <mu2>1.0</mu2>
            <fdir1>0 0 1</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <!-- ================= MIDDLE LEFT WHEEL ================= -->
  <link name="middle_left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="10.0"/>
      <inertia ixx="1.808333" ixy="0" ixz="0"
               iyy="1.808333" iyz="0"
               izz="3.2"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.8" length="0.5"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.8" length="0.5"/>
      </geometry>
    </collision>
  </link>

  <joint name="middle_left_wheel_joint" type="continuous">
    <origin xyz="0 1.65 0" rpy="-1.5707 0 0"/>
    <parent link="chassis"/>
    <child link="middle_left_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <gazebo reference="middle_left_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>  <!-- High grip scrub, because middle -->
            <mu2>1.0</mu2>
            <fdir1>0 0 1</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <!-- ================= MIDDLE RIGHT WHEEL ================= -->
  <link name="middle_right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="10.0"/>
      <inertia ixx="1.808333" ixy="0" ixz="0"
               iyy="1.808333" iyz="0"
               izz="3.2"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.8" length="0.5"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.8" length="0.5"/>
      </geometry>
    </collision>
  </link>

  <joint name="middle_right_wheel_joint" type="continuous">
    <origin xyz="0 -1.65 0" rpy="-1.5707 0 0"/>
    <parent link="chassis"/>
    <child link="middle_right_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <gazebo reference="middle_right_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>  <!-- High grip scrub, because middle -->
            <mu2>1.0</mu2>
            <fdir1>0 0 1</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <!-- ================= FRONT LEFT WHEEL ================= -->
  <link name="front_left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="10.0"/>
      <inertia ixx="1.808333" ixy="0" ixz="0"
               iyy="1.808333" iyz="0"
               izz="3.2"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.8" length="0.5"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.8" length="0.5"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <origin xyz="2 1.65 0" rpy="-1.5707 0 0"/>
    <parent link="chassis"/>
    <child link="front_left_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <gazebo reference="front_left_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.02</mu>  <!-- low grip sideways, allows scrub -->
            <mu2>1.0</mu2> <!-- high grip in rolling direction -->
            <fdir1>0 0 1</fdir1>  <!-- rolling axis direction, in link's local frame -->
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <!-- ================= FRONT RIGHT WHEEL ================= -->
  <link name="front_right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="10.0"/>
      <inertia ixx="1.808333" ixy="0" ixz="0"
               iyy="1.808333" iyz="0"
               izz="3.2"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.8" length="0.5"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.8" length="0.5"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <origin xyz="2 -1.65 0" rpy="-1.5707 0 0"/>
    <parent link="chassis"/>
    <child link="front_right_wheel"/>
    <axis xyz="0 0 1"/>
  </joint>

  <gazebo reference="front_right_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.02</mu>
            <mu2>1.0</mu2>
            <fdir1>0 0 1</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <!-- ================= DIFF DRIVE PLUGIN ================= -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>back_left_wheel_joint</left_joint>
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>middle_left_wheel_joint</left_joint>
      <right_joint>back_right_wheel_joint</right_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>middle_right_wheel_joint</right_joint>
      <wheel_separation>3.3</wheel_separation>
      <wheel_radius>0.8</wheel_radius>
      <odom_publish_frequency>1</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>/model/bulldozer/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
  </gazebo>

  <!-- ================= BLADE POSITION CONTROLLER ================= -->
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>chassis_to_blade</joint_name>
      <!-- Target displacement in metres from the joint's mounting position. -->
      <topic>/model/bulldozer/blade/cmd_pos</topic>
      <initial_position>0.0</initial_position>
      <p_gain>200.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>30.0</d_gain>
      <!-- Upward support for the current 1 kg blade in 9.8 m/s^2 gravity. -->
      <cmd_offset>9.8</cmd_offset>
      <!-- Force limits in newtons, matching the joint's 100 N effort limit. -->
      <cmd_max>100.0</cmd_max>
      <cmd_min>-100.0</cmd_min>
    </plugin>
  </gazebo>

  <!-- ================= JOINT STATE PUBLISHER ================= -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>
</robot>
